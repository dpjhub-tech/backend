# ==========================================
# Database (Local Docker PostgreSQL or Supabase)
# ==========================================
# For local Docker Compose:
DATABASE_URL="postgresql://promylink:promylink@localhost:5432/promylink?schema=public"
DIRECT_URL="postgresql://promylink:promylink@localhost:5432/promylink?schema=public"

# Local Docker PostgreSQL Credentials
POSTGRES_USER=promylink
POSTGRES_PASSWORD=promylink
POSTGRES_DB=promylink
POSTGRES_PORT=5432

# ==========================================
# Supabase Authentication & Admin API
# ==========================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ==========================================
# Server Configuration & CORS
# ==========================================
PORT=4000
CORS_ORIGIN="http://localhost:3000"
